---
// Services.astro — the "What we do" section with the 6 concept cards.
//
// ✏️ To add, remove or edit a card, just change this list.
//    Each card needs: num (the small number), icon (any symbol/emoji),
//    title and text. The HTML below repeats itself once per card.
const cards = [
  { num: '01', icon: '🌐', title: 'Websites', text: 'Sites for businesses, brands and personal projects, planned page by page.' },
  { num: '02', icon: '🖥', title: 'Web Apps', text: 'Tools, dashboards and portals that do real work in the browser.' },
  { num: '03', icon: '📱', title: 'Mobile Apps', text: 'App ideas mapped from screen to screen before any code gets written.' },
  { num: '04', icon: '📇', title: 'CRMs', text: 'Custom systems to track customers, leads, jobs and follow-ups, built around how your business works.' },
  { num: '05', icon: '🧭', title: 'UX & Wireframes', text: 'Layouts and user flows that show how everything fits together. Try sketching yours!', href: 'build/' },
  { num: '06', icon: '🎨', title: 'UI Design & Branding', text: 'The look and feel: colors, type and visual style.' },
  { num: '07', icon: '🚀', title: 'Launch Planning', text: 'Hosting, features and next steps so your concept can go live.' },
];
import { asset } from '../utils/asset.js';
---
<!-- WHAT WE DO -->
<section class="section" id="what-we-do" aria-labelledby="wwd-title">
  <div class="container">
    <header class="section__head">
      <p class="eyebrow">What we do</p>
      <h2 id="wwd-title" class="section__title">Your next website or app starts here.<br><span class="muted">From first idea to clickable concept.</span></h2>
      <p class="section__lead">Bring us a rough idea and we'll shape it into a clear web concept you can see. Then we'll test it, build it and launch it for you.</p>
    </header>
    <ol class="cards" role="list">
      {cards.map((card) => (
        card.href ? (<li class="card card--link"><a class="card__cover" href={asset(card.href)} aria-label={`${card.title}: build your idea`}></a>
          <span class="card__num">{card.num}</span>
          <span class="card__icon" aria-hidden="true">{card.icon}</span>
          <h3>{card.title}</h3>
          <p>{card.text}</p>
        <span class="card__cta">Build your idea &rarr;</span></li>) : (<li class="card">
          <span class="card__num">{card.num}</span>
          <span class="card__icon" aria-hidden="true">{card.icon}</span>
          <h3>{card.title}</h3>
          <p>{card.text}</p>
        </li>)
      ))}
    </ol>
  </div>
</section>
