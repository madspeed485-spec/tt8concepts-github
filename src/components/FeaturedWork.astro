---
import { asset } from '../utils/asset.js';
// FeaturedWork.astro: real projects TT8 Concepts has designed and built.
// To add another project, copy one <article> block and change the text and link.
---
<!-- FEATURED WORK -->
<section class="section section--tight" id="projects" aria-labelledby="projects-title">
  <div class="container">
    <header class="section__head">
      <p class="eyebrow">Featured project</p>
      <h2 id="projects-title" class="section__title">From concept <span class="grad-text nowrap">to live site.</span></h2>
    </header>
    <article class="feature" style={`--shot: url(${asset("images/zatg-header.jpg")})`}>
      <div class="feature__body">
        <span class="tag">Event website</span>
        <h3 class="feature__title">Z&rsquo;s at the Gap</h3>
        <p>We took the yearly Nissan Z gathering at the Tail of the Dragon from idea to a live event page. It has the save-the-date details, a lodging block with a built-in group code, a photo gallery, and links to the community's Facebook and Instagram, all in one fast, mobile-friendly site.</p>
        <ul class="feature__list" role="list">
          <li>Event concept and page layout</li>
          <li>Design and branding to match the Z community</li>
          <li>Built and launched at zsatthegap.com</li>
        </ul>
        <a class="btn" href="https://zsatthegap.com/" target="_blank" rel="noopener noreferrer">Preview the event page <span aria-hidden="true">&rarr;</span><span class="sr-only">(opens in a new tab)</span></a>
      </div>
    </article>
  </div>
</section>

<style>
  .section--tight { padding-top: 24px; }
  .feature { position: relative; overflow: hidden; isolation: isolate; border: 1px solid var(--line); border-radius: 20px; padding: clamp(24px, 4vw, 48px); background: #000; min-height: 420px; }
  .feature::before { content: ""; position: absolute; inset: 0; z-index: -2; background: var(--shot) right top / cover no-repeat; opacity: .9; }
  .feature::after { content: ""; position: absolute; inset: 0; z-index: -1;
    background:
      linear-gradient(90deg, rgba(0,0,0,.95) 0%, rgba(0,0,0,.8) 38%, rgba(0,0,0,.25) 75%, rgba(0,0,0,.45) 100%),
      radial-gradient(ellipse at center, transparent 50%, rgba(0,0,0,.9) 100%);
    box-shadow: inset 0 0 80px 30px #000; }
  .feature__body { max-width: 640px; text-shadow: 0 2px 12px rgba(0,0,0,.8); }
  .feature__title { font-size: clamp(28px, 4vw, 44px); margin: 12px 0; }
  .feature__list { margin: 20px 0 28px; padding-left: 20px; color: var(--text); }
  .feature__list li { margin: 6px 0; }
  @media (max-width: 720px) { .feature::after { background: linear-gradient(180deg, rgba(0,0,0,.6), rgba(0,0,0,.92)); } }
</style>