---
// Hero.astro — the big first section: car photo, headline, buttons and the
// animated infinity/gears artwork.
// Images live in public/images/. We wrap their paths in asset() so they
// still work when the site is served from /tt8concepts-github/ on GitHub Pages.
import { asset } from '../utils/asset.js';
---
<!-- HERO -->
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__media">
    <picture class="hero__photo">
      <source type="image/webp" srcset={`${asset("images/dreams-car-960.webp")} 960w, ${asset("images/dreams-car.webp")} 1920w`} sizes="100vw">
      <img src={asset("images/dreams-car.jpg")} srcset={`${asset("images/dreams-car-960.jpg")} 960w, ${asset("images/dreams-car.jpg")} 1920w`} sizes="100vw"
           width="1920" height="1280" loading="eager" fetchpriority="high" decoding="async"
           alt="Grey Nissan Z Nismo driving on a tree-lined road">
    </picture>
    <div class="hero__shade" aria-hidden="true"></div>
  </div>
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow"><span class="dot" aria-hidden="true"></span> An ideas &amp; concept studio</p>
      <h1 id="hero-title" class="hero__title">
        Every idea<br> has a shape.<br>
        <span class="grad-text">We find it.</span>
      </h1>
      <p class="hero__lead">
        T&amp;T 8 Concepts turns sparks into fully formed concepts — products, experiences,
        campaigns and whatever comes next. Bring a hunch, a sketch or a blank page. We’ll bring the rest.
      </p>
      <div class="hero__ctas">
        <a href="#contact" class="btn">Start a concept <span aria-hidden="true">→</span></a>
        <a href="#what-we-do" class="btn btn--ghost">Explore what we make</a>
      </div>
    </div>
    <div class="hero__art" aria-hidden="true">
      <div class="infinity">
        <svg class="gears" viewBox="0 0 400 220" aria-hidden="true" focusable="false">
