---
// Process.astro — the "How it works" section (Spark → Shape → Build).
// ✏️ Edit the steps in this list; the number badge is added automatically.
const steps = [
  { title: 'Spark', text: 'We talk through your idea, who it\'s for and what it needs to do.' },
  { title: 'Shape', text: 'We sketch the pages, screens and flows so you can see it before it\'s built.' },
  { title: 'Build', text: 'You get a polished concept and a clear plan, ready to develop and launch.' },
];
---
<!-- PROCESS -->
<section class="section section--alt" id="process" aria-labelledby="process-title">
  <div class="container">
    <header class="section__head">
      <p class="eyebrow">How it works</p>
      <h2 id="process-title" class="section__title">Spark. Shape. Build.</h2>
      <p class="section__lead">A simple loop that keeps ideas moving — and keeps you in the room the whole way.</p>
    </header>
    <ol class="steps" role="list">
      {steps.map((step, i) => (
        <li class="step">
          <div class="step__badge" aria-hidden="true"><span>{i + 1}</span></div>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
