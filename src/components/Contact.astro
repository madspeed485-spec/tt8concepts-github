---
// Contact.astro — contact details + the "Send my idea" form.
// The form doesn't need a server: the script in BaseLayout.astro turns the
// answers into an email (a mailto: link) addressed to madsppeed485@gmail.com.
// ✏️ To change the phone/email/address, edit them here AND in Footer.astro
//    (and the email in the script in BaseLayout.astro).
---
<!-- CONTACT -->
<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="container contact__grid">
    <div class="contact__copy">
      <p class="eyebrow">Let’s make something</p>
      <h2 id="contact-title" class="section__title">Got an idea?<br><span class="grad-text">Let’s give it a shape.</span></h2>
      <p class="section__lead">Tell us what’s on your mind — half-formed is perfectly fine. We’ll get back to you to talk it through.</p>
      <ul class="contact__points" role="list">
        <li>Any size of idea, any stage</li>
        <li>A conversation first, not a sales pitch</li>
        <li>Concepts you can actually use</li>
      </ul>
      <address class="details" aria-label="Contact details">
        <a class="detail" href="tel:+19805056940">
          <span class="detail__icon"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg></span>
          <span class="detail__text"><span class="detail__label">Phone</span><span class="detail__value">(980) 505-6940</span></span>
        </a>
        <a class="detail" href="mailto:madsppeed485@gmail.com">
          <span class="detail__icon"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="2" y="4" width="20" height="16" rx="3"/><path d="m22 7-10 6L2 7"/></svg></span>
          <span class="detail__text"><span class="detail__label">Email</span><span class="detail__value">madsppeed485@gmail.com</span></span>
        </a>
        <a class="detail" href="https://www.google.com/maps/search/?api=1&amp;query=9412+Graywell+Ln+Charlotte+NC+28277" target="_blank" rel="noopener noreferrer">
          <span class="detail__icon"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg></span>
          <span class="detail__text"><span class="detail__label">Location</span><span class="detail__value">9412 Graywell Ln, Charlotte, NC 28277</span></span>
          <span class="sr-only">(opens Google Maps in a new tab)</span>
        </a>
      </address>
    </div>
    <form class="form" id="contact-form" novalidate>
      <div class="form__row">
        <div class="field">
          <label for="name">Your name</label>
          <input id="name" name="name" type="text" autocomplete="name" placeholder="Jane Doe" required>
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required>
        </div>
      </div>
      <div class="field">
        <label for="type">Type of concept</label>
        <select id="type" name="type">
          <option>Not sure yet — surprise me</option>
          <option>Product</option>
          <option>Digital experience</option>
          <option>Spatial &amp; events</option>
          <option>Campaign &amp; story</option>
          <option>Content &amp; media</option>
          <option>Future &amp; innovation</option>
        </select>
      </div>
      <div class="field">
        <label for="message">Your idea</label>
        <textarea id="message" name="message" rows="5" placeholder="A few sentences about what you’re imagining…" required></textarea>
      </div>
      <button type="submit" class="btn btn--full">Send my idea <span aria-hidden="true">→</span></button>
      <p class="form__status" id="form-status" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>
